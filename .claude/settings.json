{
  "projectRoot": "./",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm test)"
    ],
    "deny": [
      "Bash(sudo:*)",

      "Read(../**)",
      "Read(/**)",

      "Bash(rm -rf:*)",

      "Read(.env)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*.key)",
      "Read(**/*_token)",
      "Read(**/.token*)",
      "Read(**/token)",
      "Read(**/api_key*)",
      "Read(**/*secret*)",

      "Write(../**)",
      "Write(.env*)",
      "Write(**/secrets/**)",

      "Bash(git reset:*)",
      "Bash(git rebase:*)",

      "Bash(psql:*)",
      "Bash(mysql:*)"
    ]
  }
}
